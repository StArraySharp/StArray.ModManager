<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Silk.NET.Direct3D11" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Direct3D12" Version="2.23.0" />
    <PackageReference Include="Silk.NET.DXGI" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Direct3D.Compilers" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Windowing" Version="2.23.0" />
    <PackageReference Include="Silk.NET.Input" Version="2.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\StArray.ModManager.Windows\StArray.ModManager.Windows.csproj" />
  </ItemGroup>

  <Target Name="CopyNativeDll" AfterTargets="Build">
    <ItemGroup>
      <_NativeDlls Include="..\StArray.ModManager.Windows\bin\$(Configuration)\net10.0\StArray.ModManager.Windows.Native.dll"/>
    </ItemGroup>
    <Copy SourceFiles="@(_NativeDlls)"
          DestinationFolder="$(OutputPath)"
          SkipUnchangedFiles="true"
          Condition="Exists('..\StArray.ModManager.Windows\bin\$(Configuration)\net10.0\')" />
  </Target>

</Project>
